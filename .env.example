# Copia in ~/.elsewhere/.env (install.sh lo fa per te con una password casuale)

# Password per accedere dal browser (obbligatoria, min 8 caratteri, "changeme" rifiutata)
ELSEWHERE_PASSWORD=changeme

# Opzionale: ascolta anche sulla rete locale, non solo sul tunnel.
# ATTENZIONE: il link Wi-Fi è HTTP in chiaro, password e schermo viaggiano
# non cifrati sulla LAN. Attivalo solo su reti di cui ti fidi.
# ELSEWHERE_BIND=0.0.0.0

# Opzionale: invio automatico del link su Telegram (token da @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opzionale: tunnel Cloudflare fisso invece del link trycloudflare casuale.
# Richiede `cloudflared tunnel login` + `cloudflared tunnel create <nome>` e ~/.cloudflared/config.yml
ELSEWHERE_TUNNEL_NAME=
ELSEWHERE_TUNNEL_HOST=
